<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ConectaPro+ - Curso de Espetinho</title>
    <!-- <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    /> -->
    <link rel="stylesheet" href="/stylesheets/cursos/espetinho/style.css" />
  </head>

  <body>
    <header>
      <div class="header-left">
        <i class="fas fa-bars menu-icon"></i>
        <div class="logo">
          <a href="/portal">CONECTAPRO<span>+</span></a>
        </div>
      </div>
      <!-- <div class="header-center">
        <a href="../../../../Portal/index.html">Início</a>
        <span>|</span>
        <a href="#">Cursos</a>
      </div>
      <div class="header-right">
        <div class="user-avatar">
          <i class="fas fa-user"></i>
        </div>
      </div> -->
    </header>

    <div class="main-container">
      <section class="content-area">
        <h1 class="course-title">Espetinho - Aula 01</h1>

        <div class="video-player">
          <iframe
            id="youtube-player"
            src="https://www.youtube.com/embed/4XiEHjjmD9o?enablejsapi=1"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          >
          </iframe>
        </div>

        <div class="lesson-info">
          <h2 class="lesson-title"></h2>

          <div class="completion-checklist">
            <div class="checkbox-wrapper">
              <input type="checkbox" id="lessonCheck" />
            </div>
            <label for="lessonCheck" class="checkbox-label">
              Marcar aula como concluída
            </label>
            <span class="status-msg" id="statusMsg">Pendente</span>
          </div>
        </div>
      </section>

      <aside class="sidebar">
        <div class="module-item">
          <a href="/cursos/espetinho/aula/01"><span>Aula 01</span></a>
          <i class="fas fa-chevron-down"></i>
        </div>
        <div class="module-item">
          <a href="/cursos/espetinho/aula/02"><span>Aula 02</span></a>
          <i class="fas fa-chevron-down"></i>
        </div>
        <div class="module-item">
          <a href="/cursos/espetinho/aula/03"><span>Aula 03</span></a>
          <i class="fas fa-chevron-down"></i>
        </div>
        <div class="module-item">
          <a href="/cursos/espetinho/aula/04"><span>Aula 04</span></a>
          <i class="fas fa-chevron-down"></i>
        </div>
        <div class="module-item">
          <a href="/cursos/espetinho/aula/05"><span>Aula 05</span></a>
          <i class="fas fa-chevron-down"></i>
        </div>
      </aside>
    </div>

    <footer class="main-footer">
      <div class="footer-content">
        <div class="logo">
          <a href="/portal">CONECTAPRO<span>+</span></a>
        </div>
        <p class="footer-bottom">
          &copy; 2025 CONECTAPRO+. Capacitando talentos.
        </p>
      </div>
    </footer>

    <script src="../../js/script.js"></script>
    <script>
      const checkbox = document.getElementById("lessonCheck");
      const statusMsg = document.getElementById("statusMsg");

      const lessonKey = "lesson_completed_" + window.location.pathname;

      function updateStatus() {
        statusMsg.textContent = checkbox.checked ? "Concluída" : "Pendente";
      }

      window.addEventListener("load", () => {
        const saved = localStorage.getItem(lessonKey);

        checkbox.checked = saved === "true";
        updateStatus();
      });

      checkbox.addEventListener("change", () => {
        localStorage.setItem(lessonKey, checkbox.checked);
        updateStatus();
      });
    </script>
    {# <script
      type="module"
      src="../../../../../firebase/verificaSeEstaLogado.js"
    ></script> #}
  </body>
</html>
